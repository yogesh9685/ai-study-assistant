# Copy this file to .env and fill in your real values.
# Never commit the actual .env file — it is already in .gitignore.

# ──────────────────────────────
# LLM Provider
# ──────────────────────────────
# Get your key from https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# ──────────────────────────────
# Application
# ──────────────────────────────
APP_NAME=AI Study Assistant
ENVIRONMENT=development
DEBUG=false

# ──────────────────────────────
# Server ports (local development)
# ──────────────────────────────
BACKEND_PORT=8000
FRONTEND_PORT=8501

# ──────────────────────────────
# Streamlit → FastAPI URL
# Set this when deploying so Streamlit knows where the backend is.
# ──────────────────────────────
# API_BASE_URL=http://localhost:8000
